#version 460
#extension GL_EXT_scalar_block_layout : enable

#define FRESNEL
#define EPSILON 0.0001
#define BIAS 0.001

// 1D array, will have to find out if these numbers are good
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;


struct Material {
    vec3 color;
    float roughness;
    float IOR;
    float transparency;
};


struct Object {
    Material material;
};


struct Sphere {
    uint obj;
    float radius;
    vec3 center;
};


struct Triangle {
    uint obj;
    vec3 v0;
    vec3 v1;
    vec3 v2;
    vec3 normal;
};


struct Light {
    vec3 location;
    vec3 color;
};


struct Hit {
    bool did_hit;
    vec3 location;
    vec3 normal;
    float t;
    uint obj;
};


struct Ray {
    bool s; // whether the ray has had a specular reflection
    float strength;
    vec3 color;
    vec3 origin;
    vec3 direction;
};


struct Photon {
    vec3 color;
    vec3 incident;
    vec3 location;
    int axis;
};


layout(std430, binding = 0) readonly uniform Config {
    uint photons_per_light;
    uint photons_total;
    int bounces;
} config;


layout(std430, binding = 1) readonly buffer ObjectBuffer {
    int object_amount;
    Object objects[];
};


layout(std430, binding = 2) readonly buffer SphereBuffer {
    int sphere_amount;
    Sphere spheres[];
};


layout(std430, binding = 3) readonly buffer TriangleBuffer {
    int triangle_amount;
    Triangle triangles[];
};


layout(std430, binding = 4) readonly buffer LightBuffer {
    int light_amount;
    Light lights[];
};


layout(binding = 5) writeonly buffer PhotonBuffer {
    int _photon_count;
    Photon photons[];
};


const Photon MISS = {vec3(0.0), vec3(0.0), vec3(0.0), -1};


uint seed;


float noise() {
    seed = seed * 747796405u + 2891336453u ;
    uint w = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return float(w) / 4294967295.0;
}


vec3 ray_at(Ray ray, float t) {
    return ray.origin + t * ray.direction;
}


vec3 random_direction() {
    return normalize(vec3(
        noise() - 0.5,
        noise() - 0.5,
        noise() - 0.5
    ));
}


Hit intersect_sphere(Sphere sphere, Ray ray) {
    Hit hit;
    hit.did_hit = false;

    float a = dot(ray.direction, ray.direction);
    float b = 2 * dot(ray.direction, (ray.origin - sphere.center));
    float c = dot(ray.origin - sphere.center, ray.origin - sphere.center) - sphere.radius * sphere.radius;

    float d = b * b - 4 * a * c;

    if (d < 0.0) {
        return hit;
    }

    hit.t = (-b - sqrt(d)) / (2 * a);

    if (hit.t <= EPSILON) {
        hit.t = (-b + sqrt(d)) / (2 * a);
    }

    //it hit
    hit.obj = sphere.obj;
    hit.did_hit = hit.t > EPSILON;
    hit.location = ray_at(ray, hit.t);
    hit.normal = normalize(hit.location - sphere.center);

    return hit;
}


Hit intersect_triangle(Triangle t, Ray r) {
    Hit hit;

    t.v1 -= t.v0;
    t.v2 -= t.v0;

    hit.normal = t.normal;
    float d = dot(hit.normal, r.direction);

    if (abs(d) < EPSILON) {
        hit.did_hit = false;
        return hit;
    }

    hit.t = dot(t.v0 - r.origin, hit.normal) / d;
    hit.location = ray_at(r, hit.t);

    // solve u, v such that p = u * t.v1 + v * t.v2
    vec3 p = hit.location - t.v0;

    float d11 = dot(t.v1, t.v1);
    float d12 = dot(t.v2, t.v1);
    float d1p = dot(t.v1, p);
    float d22 = dot(t.v2, t.v2);
    float d2p = dot(t.v2, p);

    float n = 1.0 / (d22 * d11 - d12 * d12);
    float u = (d11 * d2p - d12 * d1p) * n;
    float v = (d22 * d1p - d12 * d2p) * n;

    // for a triangle, the following must hold
    hit.did_hit = hit.t > EPSILON && u + EPSILON > 0.0 && v + EPSILON > 0.0 && u + v < 1.0 + EPSILON;
    hit.obj = t.obj;

    return hit;
}


Hit intersect_scene(Ray ray) {
    Hit hit;
    hit.t = 1.0 / 0.0;
    hit.did_hit = false;

    if (ray.strength < EPSILON) {
        return hit;
    }

    for (int i = 0; i < sphere_amount; i++) {
        Hit attempt = intersect_sphere(spheres[i], ray);

        if (attempt.did_hit && attempt.t < hit.t) {
            hit = attempt;
        }
    }

    for (int i = 0; i < triangle_amount; i++) {
        Hit attempt = intersect_triangle(triangles[i], ray);

        if (attempt.did_hit && attempt.t < hit.t) {
            hit = attempt;
        }
    }

    return hit;
}


void glass_shading(inout Ray ray, Hit hit) {
    Material mat = objects[hit.obj].material;

    vec3 N = hit.normal;
    vec3 D = normalize(ray.direction);

    bool inside = dot(hit.normal, D) > 0;

    if (inside) {
        N = -N;
    }

    float ni = inside ? mat.IOR : 1.0;
    float nt = inside ? 1.0 : mat.IOR;

    vec3 refraction = refract(D, N, ni / nt);

    float k0 = pow((ni - nt) / (ni + nt), 2);

    float kr = dot(refraction, refraction) == 0.0 ? 1.0 : k0 + (1 - k0) * pow(1 - dot(-D, N), 5);
    float kt = 1 - kr;

    if (noise() < kr) {
        ray.origin = hit.location + BIAS * N;
        ray.direction = reflect(D, N);
    } else {
        ray.color *= mat.color;
        ray.origin = hit.location - BIAS * N;
        ray.direction = refraction;
    }
}


Photon photon_hit(inout Ray ray, Hit hit) {
    Material mat = objects[hit.obj].material;

    float r = noise() * (1 + mat.transparency);

    Photon p = {
        ray.color,
        ray.direction,
        hit.location + BIAS * hit.normal,
        0
    };

    if (r <= mat.roughness) { // diffuse reflection
        ray.strength = 0.0;
    } else if (r <= 1.0) { // specular reflection
        ray.s = true;
        ray.color *= mat.color;
        ray.origin = p.location;
        ray.direction = reflect(ray.direction, hit.normal);
    } else {
        // refraction
        ray.s = true;
        glass_shading(ray, hit);
    }

    return mat.roughness < 1.0 || !ray.s ? MISS : p;
}


bool shoot_photon(uint index) {
    uint l = index / config.photons_per_light;
    uint i = index % config.photons_per_light;

    Light light = lights[l];

    Ray ray = {
        false,
        1.0,
        light.color,
        light.location,
        random_direction()
    };

    Hit hit = intersect_scene(ray);
    photon_hit(ray, hit);

    if (!ray.s) {
        return false;
    }

    for (int k = 0; ray.strength > EPSILON && k < config.bounces; k++) {
        Hit hit = intersect_scene(ray);
        
        if (!hit.did_hit) {
            break;
        }

        photons[index] = photon_hit(ray, hit);
    }

    return ray.strength < EPSILON;
}


void main() {
    uint i = gl_GlobalInvocationID.x;

    if (i >= config.photons_total) {
        return;
    }

    seed = gl_GlobalInvocationID.x;

    int attempt;

    for (attempt = 0; attempt < 4; attempt++) {
        if (shoot_photon(i)) {
            break;
        }
    }

    if (attempt == 4) {
        photons[i] = MISS;
    }
}

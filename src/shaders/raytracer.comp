#version 460
#extension GL_EXT_scalar_block_layout : enable

#define FRESNEL
#define EPSILON 0.0001
#define BIAS 0.001
#define PI 3.14159
#define K 40
#define FILTER_K 1.2

uint seed;

float noise() {
    seed = seed * 747796405u + 2891336453u ;
    uint w = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return float(w) / 4294967295.0;
}

// This shader is run in little tiles of 8x8x1 pixels
// We need to specify this because we are using Compute Shaders
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;


struct Material {
    vec3 color;
    float roughness;
    float IOR;
    float transparency;
};


struct Object {
    Material material;
};


struct Sphere {
    uint obj;
    float radius;
    vec3 center;
};


struct Triangle {
    uint obj;
    vec3 v0;
    vec3 v1;
    vec3 v2;
    vec3 normal;
};


struct Light {
    vec3 location;
    vec3 color;
};

struct Hit {
    bool did_hit;
    vec3 location;
    vec3 normal;
    float t;
    uint obj;
};

struct Ray {
    float strength;
    vec3 color;
    vec3 color_mult;
    vec3 origin;
    vec3 direction;
};


struct Photon {
    vec3 color;
    vec3 incident;
    vec3 location;
    int axis;
};


vec3 ray_at(Ray ray, float t) {
    return ray.origin + t * ray.direction;
}


layout(std430, binding = 0) readonly uniform Camera {
    vec3 origin;
    float focal_len;
    uvec2 resolution;
    int subpixels_per_axis;
    bool render_shadows;
    int bounces;
} camera;


layout(std430, binding = 1) readonly buffer ObjectBuffer {
    int object_amount;
    Object objects[];
};


layout(std430, binding = 2) readonly buffer SphereBuffer {
    int sphere_amount;
    Sphere spheres[];
};


layout(std430, binding = 3) readonly buffer TriangleBuffer {
    int triangle_amount;
    Triangle triangles[];
};


layout(std430, binding = 4) readonly buffer LightBuffer {
    int light_amount;
    Light lights[];
};


layout(binding = 5) readonly buffer PhotonBuffer {
    int photon_amount;
    Photon photons[];
};


layout(binding = 6) writeonly uniform image2D output_image;


vec3 random_direction() {
    return normalize(vec3(
        noise() - 0.5,
        noise() - 0.5,
        noise() - 0.5
    ));
}


vec3 random_direction(vec3 normal) {
    vec3 random = normalize(vec3(
        noise() - 0.5,
        noise() - 0.5,
        noise() - 0.5
    ));

    if (dot(random, normal) < 0) {
        random *= -1;
    }

    return random;
}


Ray generate_ray(vec2 coord) {
    Ray r = {
        1.0,
        vec3(0.0),
        vec3(1.0, 1.0, 1.0),
        camera.origin,
        vec3(
            2 * (coord.x) / camera.resolution.x - 1,
            -2 * (coord.y) / camera.resolution.y + 1,
            camera.focal_len
        )
    };

    r.direction = normalize(r.direction);
    return r;
}



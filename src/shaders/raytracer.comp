#version 460
#extension GL_EXT_scalar_block_layout : enable

#define FRESNEL
#define EPSILON 0.0001
#define BIAS 0.001
#define PI 3.14159

uint seed;

float noise() {
    seed = seed * 747796405u + 2891336453u ;
    uint w = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return float(w) / 4294967295.0;
}

// This shader is run in little tiles of 8x8x1 pixels
// We need to specify this because we are using Compute Shaders
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;


struct Material {
    vec3 color;
    float roughness;
    float IOR;
    float transparency;
};


struct Object {
    Material material;
};


struct Sphere {
    uint obj;
    float radius;
    vec3 center;
};


struct Triangle {
    uint obj;
    vec3 v0;
    vec3 v1;
    vec3 v2;
    vec3 normal;
};


struct Light {
    vec3 location;
    vec3 color;
};

struct Hit {
    bool did_hit;
    vec3 location;
    vec3 normal;
    float t;
    uint obj;
};

struct Ray {
    float strength;
    vec3 color;
    vec3 color_mult;
    vec3 origin;
    vec3 direction;
};


struct Photon {
    vec3 color;
    vec3 incident;
    vec3 location;
    int axis;
};


vec3 ray_at(Ray ray, float t) {
    return ray.origin + t * ray.direction;
}


layout(std430, binding = 0) readonly uniform Camera {
    vec3 origin;
    float focal_len;
    uvec2 resolution;
    int subpixels_per_axis;
    bool render_shadows;
    int bounces;
} camera;


layout(std430, binding = 1) readonly buffer ObjectBuffer {
    int object_amount;
    Object objects[];
};


layout(std430, binding = 2) readonly buffer SphereBuffer {
    int sphere_amount;
    Sphere spheres[];
};


layout(std430, binding = 3) readonly buffer TriangleBuffer {
    int triangle_amount;
    Triangle triangles[];
};


layout(std430, binding = 4) readonly buffer LightBuffer {
    int light_amount;
    Light lights[];
};


layout(binding = 5) readonly buffer PhotonBuffer {
    int photon_amount;
    Photon photons[];
};


layout(binding = 6) writeonly uniform image2D output_image;


vec3 random_direction() {
    return normalize(vec3(
        noise() - 0.5,
        noise() - 0.5,
        noise() - 0.5
    ));
}


vec3 random_direction(vec3 normal) {
    vec3 random = normalize(vec3(
        noise() - 0.5,
        noise() - 0.5,
        noise() - 0.5
    ));

    if (dot(random, normal) < 0) {
        random *= -1;
    }

    return random;
}


Ray generate_ray(vec2 coord) {
    Ray r = {
        1.0,
        vec3(0.0),
        vec3(1.0, 1.0, 1.0),
        camera.origin,
        vec3(
            2 * (coord.x) / camera.resolution.x - 1,
            -2 * (coord.y) / camera.resolution.y + 1,
            camera.focal_len
        )
    };

    r.direction = normalize(r.direction);
    return r;
}


uint knn_radiance(inout vec3 color, Ray ray, vec3 location, float radius, inout float max_distance) {
    uint found = 0;
    color = vec3(0.0);

    uint previous = 0;
    uint current = 0;

    do {
        Photon p = photons[current];

        uint good, bad;
        uint parent = current > 0 ? (current - 1) / 2 : 0;

        float axis_distance = location[p.axis] - p.location[p.axis];

        if (axis_distance < 0) {
            good = 2 * current + 1;
            bad  = 2 * current + 2;
        } else {
            good = 2 * current + 2;
            bad  = 2 * current + 1;
        }
        
        if (good < photon_amount && previous <= current) { // came from parent (or started from root)
            previous = current;
            current = good;
        } else if (previous == good) { // came from "good" subtree
            if (bad < photon_amount && abs(axis_distance) < radius) { // there might be a better point on the "bad" side
                previous = current;
                current = bad;
            } else {
                previous = current;
                current = parent;
            }
        } else { // came from "bad" subtree
            previous = current;
            current = parent;
        }

        float dist = distance(location, p.location);

        if (current == parent && dist < radius) {
            max_distance = max(dist, max_distance);
            color += p.color;
            found++;
        }
    } while (previous != current);

    return found;
}


vec3 estimated_radiance3(Ray ray, vec3 location) {
    float radius = 0.1;
    float max_radius = EPSILON;
    vec3 color;

    knn_radiance(color, ray, location, radius, max_radius);

    return color / (PI * radius * radius);
}


Hit intersect_sphere(Sphere sphere, Ray ray) {
    Hit hit;
    hit.did_hit = false;

    float a = dot(ray.direction, ray.direction);
    float b = 2 * dot(ray.direction, (ray.origin - sphere.center));
    float c = dot(ray.origin - sphere.center, ray.origin - sphere.center) - sphere.radius * sphere.radius;

    float d = b * b - 4 * a * c;

    if (d < 0.0) {
        return hit;
    }

    hit.t = (-b - sqrt(d)) / (2 * a);

    if (hit.t <= EPSILON) {
        hit.t = (-b + sqrt(d)) / (2 * a);
    }

    //it hit
    hit.obj = sphere.obj;
    hit.did_hit = hit.t > EPSILON;
    hit.location = ray_at(ray, hit.t);
    hit.normal = normalize(hit.location - sphere.center);

    return hit;
}


Hit intersect_triangle(Triangle t, Ray r) {
    Hit hit;

    t.v1 -= t.v0;
    t.v2 -= t.v0;

    hit.normal = t.normal;
    float d = dot(hit.normal, r.direction);

    if (abs(d) < EPSILON) {
        hit.did_hit = false;
        return hit;
    }

    hit.t = dot(t.v0 - r.origin, hit.normal) / d;
    hit.location = ray_at(r, hit.t);

    // solve u, v such that p = u * t.v1 + v * t.v2
    vec3 p = hit.location - t.v0;

    float d11 = dot(t.v1, t.v1);
    float d12 = dot(t.v2, t.v1);
    float d1p = dot(t.v1, p);
    float d22 = dot(t.v2, t.v2);
    float d2p = dot(t.v2, p);

    float n = 1.0 / (d22 * d11 - d12 * d12);
    float u = (d11 * d2p - d12 * d1p) * n;
    float v = (d22 * d1p - d12 * d2p) * n;

    // for a triangle, the following must hold
    hit.did_hit = hit.t > EPSILON && u + EPSILON > 0.0 && v + EPSILON > 0.0 && u + v < 1.0 + EPSILON;
    hit.obj = t.obj;

    return hit;
}


Hit intersect_scene(Ray ray) {
    Hit hit;
    hit.t = 1.0 / 0.0;
    hit.did_hit = false;

    for (int i = 0; i < sphere_amount; i++) {
        Hit attempt = intersect_sphere(spheres[i], ray);

        if (attempt.did_hit && attempt.t < hit.t) {
            hit = attempt;
        }
    }

    for (int i = 0; i < triangle_amount; i++) {
        Hit attempt = intersect_triangle(triangles[i], ray);

        if (attempt.did_hit && attempt.t < hit.t) {
            hit = attempt;
        }
    }

    return hit;
}


void custom_shading(inout Ray ray, Hit hit) {
    Material mat = objects[hit.obj].material;

    // calculate fresnel to determine reflectivity
    vec3 N = hit.normal;
    vec3 D = normalize(ray.direction);

    bool inside = dot(hit.normal, D) > 0;

    if (inside) {
        N = -N;
    }

    float ni = inside ? mat.IOR : 1.0;
    float nt = inside ? 1.0 : mat.IOR;

    float r0 = pow((ni - nt) / (ni + nt), 2);
    float kr = r0 + (1 - r0) * pow(1 - dot(-D, N), 5);

    if (mat.transparency < EPSILON || noise() < kr + mat.roughness * (1 - mat.transparency)) { // reflect
        float kd = mat.roughness;
        float ks = 1 - mat.roughness;

        vec3 diffuse = vec3(0.0);
        vec3 specular = vec3(0.0);

        for (int i = 0; i < light_amount; i++) {
            vec3 L = normalize(lights[i].location - hit.location);

            Ray shadow = {0, vec3(0), vec3(0), hit.location + BIAS * N, L};
            Hit shadowHit = intersect_scene(shadow);

            if (shadowHit.did_hit && shadowHit.t < length(lights[i].location - hit.location)) {
                continue;
            }

            diffuse += max(0, dot(N, L)) * lights[i].color;

            if (max(0, dot(N, L)) > 0) {
                vec3 R = reflect(-L, N);
                specular += pow(max(0, dot(R, -D)), pow(2, ks / 0.125)) * lights[i].color;
            }
        }

        ray.color += ray.strength * (kd * diffuse * mat.color + ks * specular);
        ray.strength *= ks;
        ray.origin = hit.location + BIAS * N;
        ray.direction = mix(reflect(D, N), random_direction(N), mat.roughness);
    } else { // refract
        ray.origin = hit.location - BIAS * N;
        ray.direction = refract(D, N, ni / nt);

        if (!inside) {
            vec3 inverse_color = vec3(1.0) - mat.color;
            ray.color_mult *= vec3(1.0) - ((1 - mat.roughness) * inverse_color);
        }
    }
}


vec4 pixel_color(vec2 pixel_coords) {
    int n = 16;
    float step = 0.5 / n;
    vec3 result = vec3(0);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            Ray ray = generate_ray(pixel_coords + vec2(step * (2 * i + 1), step * (2 * j + 1)));

            for (int k = -1; ray.strength > EPSILON && k < camera.bounces; k++) {
                Hit hit = intersect_scene(ray);

                if (!hit.did_hit) {
                    break;
                }

                custom_shading(ray, hit);
            }

            result += ray.color * ray.color_mult;
        }
    }

    return vec4(result / (n * n), 1.0);
}


void main() {
    ivec2 pixel_coordinates = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(camera.resolution);

    if (any(greaterThan(pixel_coordinates, size)))
        return;

    seed = (pixel_coordinates.x & 0xFFF) | (pixel_coordinates.y & 0xFFF ) << 12;

    imageStore(output_image, pixel_coordinates, pixel_color(pixel_coordinates));
}

struct Heap {
    uint n;
    uint indices[K];
};


float heap_distance(const Heap h, uint i, vec3 x) {
    return distance(x, photons[h.indices[i]].location);
}


void heap_put(inout Heap h, vec3 x, uint p) {
    float d = distance(x, photons[p].location);

    if (h.n < K) {
        uint i = h.n;

        while (i > 0) {
            uint parent = (i - 1) / 2;

            if (heap_distance(h, parent, x) < d) {
                h.indices[i] = h.indices[parent];
                i = parent;
            } else {
                break;
            }
        }

        h.indices[i] = p;
        h.n++;

        return;
    }

    if (heap_distance(h, 0, x) < d) {
        return;
    }

    uint i = 0;

    while (true) {
        uint l = i * 2 + 1;
        uint r = i * 2 + 2;

        if (l >= h.n) {
            break;
        }

        float dl = distance(x, photons[h.indices[l]].location);

        if (r >= h.n) {
            if (d < dl) {
                h.indices[i] = h.indices[l];
                i = l;
            }
            break;
        }

        float dr = distance(x, photons[h.indices[r]].location);

        if (dr > dl && d < dr) {
            h.indices[i] = h.indices[r];
            i = r;
        } else if (d < dl) {
            h.indices[i] = h.indices[l];
            i = l;
        } else {
            break;
        }
    }

    h.indices[i] = p;
}


bool heap_could_accept(const Heap h, float distance, vec3 x) {
    return h.n < K || distance < heap_distance(h, 0, x);
}


vec3 knn_radiance(Hit hit) {
    const vec3 x = hit.location;

    vec3 color = vec3(0.0);

    uint previous = 0;
    uint current = 0;

    Heap neighbors;
    neighbors.n = 0;

    do {
        Photon p = photons[current];

        uint good, bad;
        uint parent = current > 0 ? (current - 1) / 2 : 0;

        float axis_distance = x[p.axis] - p.location[p.axis];

        if (axis_distance < 0) {
            good = 2 * current + 1;
            bad  = 2 * current + 2;
        } else {
            good = 2 * current + 2;
            bad  = 2 * current + 1;
        }
        
        if (good < photon_amount && previous <= current) { // came from parent (or started from root)
            previous = current;
            current = good;
        } else if (previous == good) { // came from "good" subtree
            if (bad < photon_amount && heap_could_accept(neighbors, abs(axis_distance), x)) { // there might be a better point on the "bad" side
                previous = current;
                current = bad;
            } else {
                previous = current;
                current = parent;
            }
        } else { // came from "bad" subtree
            previous = current;
            current = parent;
        }

        if (current == parent) {
            heap_put(neighbors, x, previous);
        }
    } while (previous != current);

    float r = distance(x, photons[neighbors.indices[0]].location);

    for (int i = 0; i < neighbors.n; i++) {
        if (distance(x, photons[neighbors.indices[i]].location) > r) {
            return vec3(1.0, 0.0, 0.0);
        }
    }

    for (int i = 0; i < neighbors.n; i++) {
        Photon p = photons[neighbors.indices[i]];
        float d = distance(x, p.location);
        color += dot(-p.incident, hit.normal) * p.color * (1 - (d / (FILTER_K * r)));
    }

    return color / ((1 - (2 / (3 * FILTER_K))) * PI * r * r);
}


vec3 estimated_radiance2(Hit hit) {
    float radius = 1.0;
    vec3 color = vec3(0.0);

    for (int i = 0; i < photon_amount; i++) {
        if (distance(photons[i].location, hit.location) < radius) {
            color += photons[i].color;
        }
    }

    return color / (PI * radius * radius);
}


vec3 estimated_radiance3(Hit hit) {
    return knn_radiance(hit);
}


Hit intersect_sphere(Sphere sphere, Ray ray) {
    Hit hit;
    hit.did_hit = false;

    float a = dot(ray.direction, ray.direction);
    float b = 2 * dot(ray.direction, (ray.origin - sphere.center));
    float c = dot(ray.origin - sphere.center, ray.origin - sphere.center) - sphere.radius * sphere.radius;

    float d = b * b - 4 * a * c;

    if (d < 0.0) {
        return hit;
    }

    hit.t = (-b - sqrt(d)) / (2 * a);

    if (hit.t <= EPSILON) {
        hit.t = (-b + sqrt(d)) / (2 * a);
    }

    //it hit
    hit.obj = sphere.obj;
    hit.did_hit = hit.t > EPSILON;
    hit.location = ray_at(ray, hit.t);
    hit.normal = normalize(hit.location - sphere.center);

    return hit;
}


Hit intersect_triangle(Triangle t, Ray r) {
    Hit hit;

    t.v1 -= t.v0;
    t.v2 -= t.v0;

    hit.normal = t.normal;
    float d = dot(hit.normal, r.direction);

    if (abs(d) < EPSILON) {
        hit.did_hit = false;
        return hit;
    }

    hit.t = dot(t.v0 - r.origin, hit.normal) / d;
    hit.location = ray_at(r, hit.t);

    // solve u, v such that p = u * t.v1 + v * t.v2
    vec3 p = hit.location - t.v0;

    float d11 = dot(t.v1, t.v1);
    float d12 = dot(t.v2, t.v1);
    float d1p = dot(t.v1, p);
    float d22 = dot(t.v2, t.v2);
    float d2p = dot(t.v2, p);

    float n = 1.0 / (d22 * d11 - d12 * d12);
    float u = (d11 * d2p - d12 * d1p) * n;
    float v = (d22 * d1p - d12 * d2p) * n;

    // for a triangle, the following must hold
    hit.did_hit = hit.t > EPSILON && u + EPSILON > 0.0 && v + EPSILON > 0.0 && u + v < 1.0 + EPSILON;
    hit.obj = t.obj;

    return hit;
}


Hit intersect_scene(Ray ray) {
    Hit hit;
    hit.t = 1.0 / 0.0;
    hit.did_hit = false;

    for (int i = 0; i < sphere_amount; i++) {
        Hit attempt = intersect_sphere(spheres[i], ray);

        if (attempt.did_hit && attempt.t < hit.t) {
            hit = attempt;
        }
    }

    for (int i = 0; i < triangle_amount; i++) {
        Hit attempt = intersect_triangle(triangles[i], ray);

        if (attempt.did_hit && attempt.t < hit.t) {
            hit = attempt;
        }
    }

    return hit;
}


void custom_shading(inout Ray ray, Hit hit) {
    Material mat = objects[hit.obj].material;

    // calculate fresnel to determine reflectivity
    vec3 N = hit.normal;
    vec3 D = normalize(ray.direction);

    bool inside = dot(hit.normal, D) > 0;

    if (inside) {
        N = -N;
    }

    float ni = inside ? mat.IOR : 1.0;
    float nt = inside ? 1.0 : mat.IOR;

    float r0 = pow((ni - nt) / (ni + nt), 2);
    float kr = r0 + (1 - r0) * pow(1 - dot(-D, N), 5);

    if (mat.transparency < EPSILON || noise() < kr + mat.roughness * (1 - mat.transparency)) { // reflect
        float kd = mat.roughness;
        float ks = 1 - mat.roughness;

        vec3 diffuse = vec3(0.0);
        vec3 specular = vec3(0.0);

        for (int i = 0; i < light_amount; i++) {
            vec3 L = normalize(lights[i].location - hit.location);

            Ray shadow = {0, vec3(0), vec3(0), hit.location + BIAS * N, L};
            Hit shadowHit = intersect_scene(shadow);

            if (shadowHit.did_hit && shadowHit.t < length(lights[i].location - hit.location)) {
                continue;
            }

            diffuse += max(0, dot(N, L)) * lights[i].color;

            if (max(0, dot(N, L)) > 0) {
                vec3 R = reflect(-L, N);
                specular += pow(max(0, dot(R, -D)), pow(2, ks / 0.125)) * lights[i].color;
            }
        }

        ray.color += ray.strength * (kd * diffuse * mat.color + ks * specular);

        if (ks < EPSILON && photon_amount > 0) {
            ray.color += ray.strength * estimated_radiance3(hit);
        }
        
        ray.strength *= ks;
        ray.origin = hit.location + BIAS * N;
        ray.direction = mix(reflect(D, N), random_direction(N), mat.roughness);
    } else { // refract
        ray.origin = hit.location - BIAS * N;
        ray.direction = refract(D, N, ni / nt);

        if (!inside) {
            vec3 inverse_color = vec3(1.0) - mat.color;
            ray.color_mult *= vec3(1.0) - ((1 - mat.roughness) * inverse_color);
        }
    }
}


vec4 pixel_color(vec2 pixel_coords) {
    int n = camera.subpixels_per_axis;
    float step = 0.5 / n;
    vec3 result = vec3(0);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            Ray ray = generate_ray(pixel_coords + vec2(step * (2 * i + 1), step * (2 * j + 1)));

            for (int k = -1; ray.strength > EPSILON && k < camera.bounces; k++) {
                Hit hit = intersect_scene(ray);

                if (!hit.did_hit) {
                    break;
                }

                custom_shading(ray, hit);
            }

            result += ray.color * ray.color_mult;
        }
    }

    return vec4(result / (n * n), 1.0);
}


void main() {
    ivec2 pixel_coordinates = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(camera.resolution);

    if (any(greaterThan(pixel_coordinates, size)))
        return;

    seed = (pixel_coordinates.x & 0xFFF) | (pixel_coordinates.y & 0xFFF ) << 12;

    imageStore(output_image, pixel_coordinates, pixel_color(pixel_coordinates));
}

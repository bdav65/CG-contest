#version 460
#extension GL_EXT_scalar_block_layout : enable

#define EPSILON 0.0001
#define PI 3.14159


layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;


struct Material {
    vec3 color;
    float ka;
    float kd;
    float ks;
    uint n;
    bool is_glass;
    float nt;
};


struct Object {
    Material material;
};


struct Sphere {
    uint obj;
    float radius;
    vec3 center;
};


struct Triangle {
    uint obj;
    vec3 v0;
    vec3 v1;
    vec3 v2;
    vec3 normal;
};


struct Light {
    vec3 location;
    vec3 color;
};


struct Hit {
    bool did_hit;
    vec3 location;
    vec3 normal;
    float t;
    uint obj;
};


struct Ray {
    float strength;
    vec3 color;
    vec3 origin;
    vec3 direction;
};


struct Photon {
    vec3 color;
    vec3 incident;
    vec3 location;
    int axis;
};


vec3 ray_at(Ray ray, float t) {
    return ray.origin + t * ray.direction;
}


layout(std430, binding = 0) readonly uniform Camera {
    vec3 origin;
    float focal_len;
    uvec2 resolution;
    int subpixels_per_axis;
    bool render_shadows;
    int bounces;
} camera;


layout(std430, binding = 1) readonly buffer ObjectBuffer {
    int object_amount;
    Object objects[];
};


layout(std430, binding = 2) readonly buffer SphereBuffer {
    int sphere_amount;
    Sphere spheres[];
};


layout(std430, binding = 3) readonly buffer TriangleBuffer {
    int triangle_amount;
    Triangle triangles[];
};


layout(std430, binding = 4) readonly buffer LightBuffer {
    int light_amount;
    Light lights[];
};


layout(binding = 5) readonly buffer PhotonBuffer {
    int photon_amount;
    Photon photons[];
};


layout(binding = 6) writeonly uniform image2D output_image;


Ray generate_ray(vec2 coord) {
    Ray r = {
        1.0,
        vec3(0),
        camera.origin,
        vec3(
            2 * (coord.x) / camera.resolution.x - 1,
            -2 * (coord.y) / camera.resolution.y + 1,
            camera.focal_len
        )
    };

    r.direction = normalize(r.direction);
    return r;
}


Hit intersect_sphere(Sphere sphere, Ray ray) {
    Hit hit;
    hit.did_hit = false;

    float a = dot(ray.direction, ray.direction);
    float b = 2 * dot(ray.direction, (ray.origin - sphere.center));
    float c = dot(ray.origin - sphere.center, ray.origin - sphere.center) - sphere.radius * sphere.radius;

    float d = b * b - 4 * a * c;

    if (d < 0.0) {
        return hit;
    }

    hit.t = (-b - sqrt(d)) / (2 * a);

    if (hit.t <= EPSILON) {
        hit.t = (-b + sqrt(d)) / (2 * a);
    }

    //it hit
    hit.obj = sphere.obj;
    hit.did_hit = hit.t > EPSILON;
    hit.location = ray_at(ray, hit.t);
    hit.normal = normalize(hit.location - sphere.center);

    return hit;
}


Hit intersect_triangle(Triangle t, Ray r) {
    Hit hit;

    t.v1 -= t.v0;
    t.v2 -= t.v0;

    hit.normal = t.normal;
    float d = dot(hit.normal, r.direction);

    if (abs(d) < EPSILON) {
        hit.did_hit = false;
        return hit;
    }

    hit.t = dot(t.v0 - r.origin, hit.normal) / d;
    hit.location = ray_at(r, hit.t);

    // solve u, v such that p = u * t.v1 + v * t.v2
    vec3 p = hit.location - t.v0;

    float d11 = dot(t.v1, t.v1);
    float d12 = dot(t.v2, t.v1);
    float d1p = dot(t.v1, p);
    float d22 = dot(t.v2, t.v2);
    float d2p = dot(t.v2, p);

    float n = 1.0 / (d22 * d11 - d12 * d12);
    float u = (d11 * d2p - d12 * d1p) * n;
    float v = (d22 * d1p - d12 * d2p) * n;

    // for a triangle, the following must hold
    hit.did_hit = hit.t > EPSILON && u + EPSILON > 0.0 && v + EPSILON > 0.0 && u + v < 1.0 + EPSILON;
    hit.obj = t.obj;

    return hit;
}


Hit intersect_scene(Ray ray) {
    Hit hit;
    hit.t = 1.0 / 0.0;
    hit.did_hit = false;

    for (int i = 0; i < sphere_amount; i++) {
        Hit attempt = intersect_sphere(spheres[i], ray);

        if (attempt.did_hit && attempt.t < hit.t) {
            hit = attempt;
        }
    }

    for (int i = 0; i < triangle_amount; i++) {
        Hit attempt = intersect_triangle(triangles[i], ray);

        if (attempt.did_hit && attempt.t < hit.t) {
            hit = attempt;
        }
    }

    return hit;
}


vec3 photon_color(vec3 location) {
    vec3 color = vec3(0.0);

    const float R = 1.0;

    for (int i = 0; i < photon_amount; i++) {
        float d = distance(location, photons[i].location);

        if (distance(location, photons[i].location) < R) {
            color += photons[i].color;
        }
    }

    return color;
}


vec3 pixel_color(vec2 pixel_coords) {
    Ray ray = generate_ray(pixel_coords);
    Hit hit = intersect_scene(ray);

    return hit.did_hit ? photon_color(hit.location) : vec3(0, 0, 0);
}


/* Program starts here! */
void main() {
    ivec2 pixel_coordinates = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(camera.resolution);

    // If the current pixel is outside of the desired size, stop rendering
    if (any(greaterThan(pixel_coordinates, size)))
        return;

    imageStore(output_image, pixel_coordinates, vec4(pixel_color(pixel_coordinates), 1.0));
}
